{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "planName": "Modified Week 12 — Athletic Cut & Core",
  "description": "Modified Week 12 training plan optimized for faster fat loss, sexual performance, hip drive, core stability, and pull-up strength.",
  "goals": [
    "Faster fat loss",
    "Sexual performance & hip drive stamina",
    "Pull-up strength progression",
    "Strong core compression & pelvic stability",
    "Joint safety & neural recovery"
  ],
  "principles": [
    "Add 1 rep or 5 seconds every week when possible",
    "Always prioritize controlled strict movement over speed",
    "1-2 RIR on compound sets; avoid failure reps",
    "Rest 60-90s between heavy sets; 30-45s on core/finishers",
    "High protein (1.8-2.2g/kg) and 7.5-9 hours continuous sleep"
  ],
  "routines": {
    "Day 1 — Pull Power + Core Stability": {
      "warmup": [
        "Dead hang — 30s (x2 rounds)",
        "Scapular pull-ups — x8 (x2 rounds)",
        "Band pull-aparts — x15 (x2 rounds)"
      ],
      "main": [
        { "name": "Pull-ups", "sets": 6, "targetReps": "3-5 reps", "restSeconds": 90, "notes": "Full ROM, controlled" },
        { "name": "Negative Pull-ups", "sets": 3, "targetReps": "3 reps", "restSeconds": 90, "notes": "6-8 sec descent" },
        { "name": "Band Rows", "sets": 3, "targetReps": "12-15 reps", "restSeconds": 90, "notes": "Squeeze lats at peak contraction" }
      ],
      "core": [
        { "name": "Hanging Knee Raises", "sets": 4, "targetReps": "10-12 reps", "restSeconds": 60, "notes": "Controlled posterior pelvic tilt" },
        { "name": "Hollow Body Hold", "sets": 4, "targetReps": "30-45s", "restSeconds": 60, "notes": "Lower back pressed firmly into floor" }
      ],
      "finisher": [
        "3 rounds — Mountain Climbers x30s",
        "3 rounds — High Knees x30s",
        "Rest 30s between rounds"
      ],
      "cue": "Explode up. Hold the hollow body tight."
    },
    "Day 2 — Legs & Glutes (Hip Power Focus)": {
      "warmup": [
        "Leg swings + Hip circles",
        "Bodyweight Squats — x15"
      ],
      "main": [
        { "name": "Bulgarian Split Squats", "sets": 4, "targetReps": "10-12 reps/leg", "restSeconds": 75, "notes": "Rear foot on chair or low parallettes" },
        { "name": "Band Hip Thrusts", "sets": 4, "targetReps": "15-20 reps", "restSeconds": 60, "notes": "Band around knees; 2s hold at lockout" },
        { "name": "Single-leg Romanian Deadlifts", "sets": 3, "targetReps": "10-12 reps/leg", "restSeconds": 60, "notes": "With band" },
        { "name": "Band Squats", "sets": 3, "targetReps": "20 reps", "restSeconds": 60, "notes": "Slow tempo" }
      ],
      "core": [
        { "name": "L-sit / Tuck Hold on Parallettes", "sets": 5, "targetReps": "15-25s", "restSeconds": 60, "notes": "Depress shoulders, compress hip flexors" }
      ],
      "finisher": [
        "4 rounds — Jump Squats x12",
        "4 rounds — Glute Bridges (bodyweight) x15",
        "Rest 30s between rounds"
      ],
      "cue": "Drive through the heels. Squeeze the glutes at the top."
    },
    "Day 3 — Rest or Active Recovery": {
      "warmup": [],
      "main": [],
      "core": [],
      "finisher": [],
      "recovery": true,
      "routine": [
        "8k+ steps walk",
        "Light stretching / mobility"
      ],
      "reflection": [
        { "id": "steps", "label": "Total steps today?" },
        { "id": "soreness", "label": "Soreness level (1-10)?" }
      ],
      "cue": "Rest is where the muscle grows and fat burns."
    },
    "Day 4 — Push + Athletic Shoulders": {
      "warmup": [
        "Wrist prep + Scapular push-ups — x12",
        "Band dislocates — x12"
      ],
      "main": [
        { "name": "Deep Parallettes Push-ups", "sets": 4, "targetReps": "10-12 reps", "restSeconds": 60, "notes": "Full depth on parallettes" },
        { "name": "Pike Push-ups", "sets": 4, "targetReps": "8-10 reps", "restSeconds": 60, "notes": "Vertical torso, push shoulders tall" },
        { "name": "Band Overhead Press", "sets": 3, "targetReps": "12-15 reps", "restSeconds": 60, "notes": "Strict press without arching back" }
      ],
      "core": [
        { "name": "Side Plank", "sets": 3, "targetReps": "45s/side", "restSeconds": 45, "notes": "Keep hips high and stable" },
        { "name": "Ab Vacuum", "sets": 3, "targetReps": "40s", "restSeconds": 45, "notes": "Full exhale, draw belly inward" }
      ],
      "finisher": [
        "3 rounds — Burpees x8",
        "3 rounds — Plank Shoulder Taps x20",
        "Rest 45s between rounds"
      ],
      "cue": "Push deep on parallettes. Engage core fully."
    },
    "Day 5 — Pull Volume + Metabolic Conditioning": {
      "warmup": [
        "Dead hang — 40s",
        "Band pull-aparts — x15"
      ],
      "main": [
        { "name": "Pull-ups", "sets": 5, "targetReps": "AMRAP", "restSeconds": 120, "notes": "Stop 1-2 reps before failure" },
        { "name": "Inverted Rows", "sets": 4, "targetReps": "10-12 reps", "restSeconds": 75, "notes": "Under bar or rings" },
        { "name": "Band Straight-Arm Pulldowns", "sets": 3, "targetReps": "15 reps", "restSeconds": 60, "notes": "Isolate lats" }
      ],
      "core": [],
      "finisher": [
        "3-4 rounds — Push-ups x10",
        "3-4 rounds — Squats x20",
        "3-4 rounds — Hanging Knee Raises x10",
        "Rest 60-75s between rounds"
      ],
      "cue": "High pull volume builds shape. Power through the metabolic circuit."
    },
    "Day 6 — Light Legs & Active Recovery": {
      "warmup": [],
      "main": [],
      "core": [],
      "finisher": [],
      "recovery": true,
      "routine": [
        "30–40 min brisk walk",
        "Hip mobility + Pigeon stretch",
        "Light band glute work",
        "Passive hang — 2 × 60s"
      ],
      "reflection": [
        { "id": "walk_time", "label": "Brisk walk duration (mins)?" },
        { "id": "hips_feel", "label": "How do your hips feel (1-10)?" }
      ],
      "cue": "Consistency in recovery builds performance."
    },
    "Day 7 — Full Rest + Reflection": {
      "warmup": [],
      "main": [],
      "core": [],
      "finisher": [],
      "recovery": true,
      "routine": [
        "Light walk, stretch, or mobility"
      ],
      "reflection": [
        { "id": "pullup_max", "label": "Pull-up max reps?" },
        { "id": "waist", "label": "Waist measurement (in/cm)?" },
        { "id": "energy_bed", "label": "Energy levels / Stamina (1-10)?" },
        { "id": "morning_wood", "label": "Recovery quality (1-10)?" }
      ],
      "cue": "Progress is measured across all indicators of health."
    }
  }
}
